# 백엔드 환경변수 예시. 실제 값은 .env 또는 시스템 환경변수로 설정한다.
# API key 는 절대 frontend 에 두지 않는다.

# 결과 디렉터리 (기본값: ../optimizer/AXIS_MOVEAI_MILP_v7_1_FINAL/05_RESULTS/AXIS_INTEGRATED)
# AXIS_RESULT_DIR=
# AXIS_INPUT_DIR=
# AXIS_SCENARIO=AXIS_INTEGRATED

# 로그인 연동 전 데모 선사
DEMO_CARRIER_ID=CARRIER_A

# dev mode 를 끄면 carrier selector 와 availableCarriers 목록이 사라진다.
# 실제 선사 배포에서는 반드시 false 로 둔다.
DEV_MODE=true

# 챗봇 API. 미설정 시 /api/chat 은 503 CHAT_API_NOT_CONFIGURED 를 반환한다.
CHAT_API_URL=
CHAT_API_KEY=

# Gemini Copilot 키 (Vercel 서버리스 api/chat.js 가 읽는다).
# 이 파일(.env.example)에는 절대 실제 키를 적지 말 것 — 커밋된다. 저장소는 public 이다.
# 실제 키는 Vercel 프로젝트 환경변수(배포)나 .env(로컬)에만 넣는다.
# 여러 키를 쉼표로 이어 GEMINI_API_KEYS 에 주면 무료 한도(429) 초과 시 다음 키로 순환한다.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
